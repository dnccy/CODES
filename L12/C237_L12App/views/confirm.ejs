<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <title>Habit Added</title>
</head>
<body>
    <%- include('partials/navbar') %>

    <div class="container mt-5 text-center">
        <div class="alert alert-success d-inline-block px-5 py-4">
            <h2 class="mb-2">✅ Habit Added!</h2>
            <p class="mb-0">Your habit <strong>"<%= habitName %>"</strong> has been added successfully.</p>
        </div>
        <div class="mt-4 d-flex justify-content-center gap-3">
            <a href="/add" class="btn btn-primary">Add Another Habit</a>
            <a href="/habits" class="btn btn-outline-secondary">View My Habits</a>
        </div>
    </div>
</body>
</html>