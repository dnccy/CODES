<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <title>My Habits</title>
</head>
<body>
    <%- include('partials/navbar') %>

    <div class="container mt-4">
        <h1 class="mb-3">My Habits</h1>

        <% if (habits.length === 0) { %>
            <div class="alert alert-info">
                No habits yet. <a href="/add">Add your first habit!</a>
            </div>
        <% } else { %>
            <table class="table table-bordered align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Habit</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% habits.forEach(habit => { %>
                    <tr>
                        <td><%= habit.name %></td>
                        <td>
                            <% if (habit.done) { %>
                                <span class="badge bg-success">Done ✅</span>
                            <% } else { %>
                                <span class="badge bg-secondary">Not Done</span>
                            <% } %>
                        </td>
                        <td>
                            <% if (!habit.done) { %>
                            <form action="/done/<%= habit.id %>" method="POST" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-success">Mark Done</button>
                            </form>
                            <% } %>
                            <form action="/delete/<%= habit.id %>" method="POST" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        <% } %>

        <a href="/add" class="btn btn-primary mt-2">+ Add Habit</a>
    </div>
</body>
</html>